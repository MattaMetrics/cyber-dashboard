{
  "global_config": {
    "platform_mission": "Democratize elite sports science and advanced ergonomics for pain-free physical longevity",
    "core_metrics": [
      "energy_efficiency_score",
      "muscle_activation_symmetry",
      "kinetic_chain_integrity",
      "compensation_risk_index",
      "center_of_mass_stability"
    ],
    "scoring_system": {
      "technique_score": { "weight": 0.35, "max": 100 },
      "balance_score": { "weight": 0.25, "max": 100 },
      "symmetry_score": { "weight": 0.2, "max": 100 },
      "flexibility_score": { "weight": 0.1, "max": 100 },
      "mobility_score": { "weight": 0.1, "max": 100 }
    },
    "age_metrics": {
      "biological_movement_age": true,
      "flexibility_age_index": true,
      "mobility_age_index": true
    },
    "progress_tracking": {
      "enable_retest_comparison": true,
      "trend_analysis_windows": ["2_week", "4_week", "8_week"]
    }
  },
  "assessments": [
    {
      "test_id": "LL001",
      "name": "NECK MOBILITY MATRIX",
      "category": "Mobility",
      "packages": ["VITAL_FLOW", "ATHLETE_PRECISION", "POSTURE_ERGONOMICS"],
      "biometric_photo_url": "https://i.imgur.com/USu4J77.png",
      "phases": [
        "neutral_calibration",
        "flexion",
        "extension",
        "lateral_flexion_left",
        "lateral_flexion_right"
      ],
      "metrics": {
        "primary": {
          "cervical_flexion_rom": {
            "type": "angle",
            "unit": "degrees",
            "target_joint": "cervical_spine",
            "description": "Chin-to-chest flexion range"
          },
          "cervical_extension_rom": {
            "type": "angle",
            "unit": "degrees",
            "target_joint": "cervical_spine",
            "description": "Upward gaze extension range"
          },
          "lateral_flexion_symmetry": {
            "type": "symmetry_ratio",
            "unit": "percentage",
            "description": "Left vs right lateral flexion balance"
          }
        },
        "secondary": {
          "forward_head_displacement": {
            "type": "distance",
            "unit": "cm",
            "description": "Anterior head translation from plumb line"
          },
          "shoulder_elevation_asymmetry": {
            "type": "angle",
            "unit": "degrees",
            "description": "Shoulder hiking during movement"
          }
        }
      },
      "scoring_rules": [
        {
          "rule_id": "LL001_R1",
          "metric": "cervical_flexion_rom",
          "phase": "flexion",
          "weight": 0.25,
          "thresholds": {
            "excellent": { "min": 45, "max": 60 },
            "good": { "min": 35, "max": 44 },
            "fair": { "min": 25, "max": 34 },
            "poor": { "min": 0, "max": 24 }
          },
          "scoring": { "excellent": 100, "good": 75, "fair": 50, "poor": 25 },
          "compensation_flags": [
            {
              "condition": "forward_head_displacement > 5",
              "flag": "Cervical compensation detected - check thoracic mobility"
            },
            {
              "condition": "shoulder_elevation > 10",
              "flag": "Upper trapezius dominance - energy leak detected"
            }
          ]
        },
        {
          "rule_id": "LL001_R2",
          "metric": "cervical_extension_rom",
          "phase": "extension",
          "weight": 0.25,
          "thresholds": {
            "excellent": { "min": 50, "max": 70 },
            "good": { "min": 40, "max": 49 },
            "fair": { "min": 30, "max": 39 },
            "poor": { "min": 0, "max": 29 }
          },
          "scoring": { "excellent": 100, "good": 75, "fair": 50, "poor": 25 }
        },
        {
          "rule_id": "LL001_R3",
          "metric": "lateral_flexion_symmetry",
          "phase": "lateral_flexion",
          "weight": 0.25,
          "thresholds": {
            "excellent": { "min": 90, "max": 100 },
            "good": { "min": 80, "max": 89 },
            "fair": { "min": 70, "max": 79 },
            "poor": { "min": 0, "max": 69 }
          },
          "scoring": { "excellent": 100, "good": 80, "fair": 60, "poor": 30 }
        },
        {
          "rule_id": "LL001_R4",
          "metric": "forward_head_displacement",
          "phase": "neutral_calibration",
          "weight": 0.25,
          "thresholds": {
            "excellent": { "min": 0, "max": 2 },
            "good": { "min": 2.1, "max": 4 },
            "fair": { "min": 4.1, "max": 6 },
            "poor": { "min": 6.1, "max": 99 }
          },
          "scoring": { "excellent": 100, "good": 75, "fair": 50, "poor": 25 },
          "energy_leak_detection": {
            "condition": "value > 4",
            "message": "Forward head posture creating cervical energy leak - 15% efficiency loss in upper kinetic chain",
            "affected_chain": ["cervical", "thoracic", "shoulder_complex"]
          }
        }
      ],
      "compensation_patterns": [
        {
          "pattern": "upper_trapezius_overactivation",
          "detection": "shoulder_elevation > 10 AND lateral_flexion_asymmetry > 15",
          "root_cause": "Deep neck flexor weakness",
          "kinetic_chain_impact": "Energy leak at C4-C7 transferring to T1-T4",
          "recommendation": "Deep neck flexor endurance training: Chin tuck holds 3x30sec, progressing to 3x60sec"
        }
      ],
      "rehabilitation_plans": {
        "2_week": [
          "Daily chin tuck holds: 3 sets x 20 seconds",
          "Gentle cervical mobilizations: 2x daily, 10 reps each direction",
          "Upper trapezius self-release: 2 minutes each side"
        ],
        "4_week": [
          "Progress to 3 sets x 45 seconds chin tucks",
          "Add resisted cervical rotation with bands",
          "Integration with thoracic mobility drills"
        ],
        "8_week": [
          "Full cervical strength protocol",
          "Integration with full-body kinetic chain exercises",
          "Sport-specific neck conditioning"
        ]
      }
    },
